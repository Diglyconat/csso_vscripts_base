	{
		english = "Display a list of available chat commands", 
		russian = "Вывести список всех доступных чат-команд"
	} )

sclt( "CSSO_ChatCommand_cmdhelp", 
	{
		english = "Display description of chat command", 
		russian = "Вывести описание чат-команды"
	} )

sclt( "CSSO_ChatCommand_chathelp", 
	{
		english = "Type {lightgreen}status {white}in console to display list of players on current server. Inside {lightgreen}[] {white}brackets input the {lightgreen}userid {white}value of the player you want to send a private message to.", 
		russian = "Введите {lightgreen}status {white}в консоли, чтобы отобразить всех игроков на сервере. Внутри скобок {lightgreen}[] {white}введите {lightgreen}userid {white}нужного вам игрока, которому вы хотите отправить личное сообщение."
	} )

sclt( "CSSO_AdminChatHelp_everyone", 
	{
		english = "You can use {greenyellow}* {white}symbol before {greenyellow}userid {white}value to send the message via specified player/bot to EVERYONE.", 
		russian = "Вы можете вставить символ {greenyellow}* {white}перед значением {greenyellow}userid {white}, чтобы отправить сообщение через указанного игрока/бота ВСЕМ ИГРОКАМ."
	} )

sclt( "CSSO_AdminChatHelp_team", 
	{
		english = "You can use {greenyellow}! {white}symbol before {greenyellow}userid {white}value to send the message to specified player/bot's TEAM.", 
		russian = "Вы можете вставить символ {greenyellow}! {white}перед значением {greenyellow}userid {white}, чтобы отправить сообщение КОМАНДЕ указанного игрока/бота."
	} )

sclt( "CSSO_AdminChatHelp_team2", 
	{
		english = "You can use {greenyellow}+ {white}symbol (CT team) or {greenyellow}- {white}symbol (T team) before {greenyellow}userid {white}value to send the message via players/bots of desired TEAM.", 
		russian = "Вы можете вставить символ {greenyellow}+ {white} (команда КТ), либо {greenyellow}- {white}символ (команда Т) перед значением {greenyellow}userid {white}, чтобы отправить сообщение через указанную КОМАНДУ игрока/бота."
	} )

sclt( "CSSO_AdminChatHelp_all", 
	{
		english = "You can use {greenyellow}. {white}symbol to send the message via EVERYONE.", 
		russian = "Вы можете вставить символ {greenyellow}. {white}, чтобы отправить сообщение от лица ВСЕХ игроков."
	} )