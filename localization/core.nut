		english = "{lightgreen}Player {yellow}%s {lightgreen}has joined the server! {whitesmoke}Steam: {yellow}%s, {whitesmoke}IP: {yellow}%s", 
		russian = "{lightgreen}Игрок {yellow}%s {lightgreen}подключился к серверу! {whitesmoke}Steam: {yellow}%s, {whitesmoke}IP: {yellow}%s"
	} )

